{
  "name": "every15-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database — every15-db was DELETED 2026-07-23 (account slot cleanup;
  // export at ~/backups/d1/2026-07-23/every15-db.sql on Sleeper). The worker
  // code still expects a DB binding: before redeploying, create a new database
  // (npx wrangler d1 create every15-db), re-add the block below with the new
  // id, and re-apply migrations.
  // "d1_databases": [{ "binding": "DB", "database_name": "every15-db", "database_id": "<new-id>" }],

  // R2 Bucket
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "every15-data"
    }
  ],

  // Workers AI
  "ai": {
    "binding": "AI"
  }
}
