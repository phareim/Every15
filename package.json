{
  "name": "every15-web",
  "version": "1.0.0",
  "description": "Every15 on the web \u2014 a personal quarter-hour journal behind Reader's login",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "jest --runInBand && node tests/quarter-checks.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phareim/every15.git"
  },
  "license": "ISC",
  "dependencies": {
    "nuxt": "^3.17.7"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "wrangler": "4.131.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/domain*.test.ts"
    ],
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "esModuleInterop": true,
            "moduleResolution": "bundler",
            "module": "commonjs",
            "target": "es2022",
            "rootDir": ".",
            "types": [
              "jest",
              "node"
            ]
          }
        }
      ]
    }
  }
}
